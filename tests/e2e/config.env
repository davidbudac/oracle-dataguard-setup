#!/usr/bin/env bash
# =============================================================================
# E2E lab configuration - the libvirt ol9_19_dg1/dg2/dg3 trio on dbmint
# =============================================================================
# Run with: bash tests/e2e/e2e.sh doctor | run --tier smoke
#
# Two networks are in play and they are NOT interchangeable:
#   * 192.168.122.x - libvirt NAT, the only one the jump host / dbmint reaches.
#     *_HOST below (ssh targets) must use these. They are DHCP leases and can
#     change: verify with `virsh -c qemu:///system domifaddr ol9_19_dg1`.
#   * 192.168.56.x  - VM-to-VM only; what /etc/hosts resolves ol9-19-dg1/2/3 to
#     and what NFS and the redo transport run over. *_ORACLE_HOSTNAME must
#     stay on these names.
# Running ON dbmint: JUMP_HOST="" (direct). From the Mac: JUMP_HOST="dbmint".
# =============================================================================

# --- Jump host ---
JUMP_HOST=""
JUMP_SSH_PORT="22"
JUMP_USER="db"
JUMP_KEY=""

# --- Database hosts ---
PRIMARY_HOST="192.168.122.193"           # ol9_19_dg1
PRIMARY_SSH_PORT="22"
PRIMARY_ORACLE_HOSTNAME="ol9-19-dg1"
STANDBY_HOST="192.168.122.194"           # ol9_19_dg2
STANDBY_SSH_PORT="22"
STANDBY_ORACLE_HOSTNAME="ol9-19-dg2"
SSH_USER="oracle"
SSH_KEY=""
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=10 -o LogLevel=ERROR"

# --- Third host (observer) ---
HOST3="192.168.122.195"                  # ol9_19_dg3 - also runs cdb1's observer; leave that one alone
HOST3_SSH_PORT="22"
HOST3_ORACLE_HOSTNAME="ol9-19-dg3"
HOST3_ORACLE_HOME="/u01/app/oracle/product/19.0.0/dbhome_1"

# --- Oracle software ---
ORACLE_HOME="/u01/app/oracle/product/19.0.0/dbhome_1"
ORACLE_BASE="/u01/app/oracle"

# --- Where the suite may write (no root) ---
LAB_FS_SLOTS="/u01/app/oracle /home/oracle /var/tmp/oracle"
LAB_FS_RENAME_TARGET="/tmp"
LAB_SCRATCH="/home/oracle/e2e"
LAB_SCRATCH_PORT="1531"

# --- NFS share (served by dg1, mounted on dg2) ---
NFS_SHARE="/OINSTALL/_dataguard_setup"

# --- Repository on the hosts (the hosts' tree has no .git: rsync it) ---
REPO_DIR="/home/oracle/dataguard_setup"
LOCAL_DEPLOY="true"
REPO_URL="https://github.com/davidbudac/oracle-dataguard-setup.git"
REPO_BRANCH="main"

# --- Test passwords ---
TEST_SYS_PASSWORD="DgTest_2024#"
TEST_OBSERVER_USER="DG_OBSERVER"
TEST_OBSERVER_PASSWORD="ObsTest_2024#"
TEST_WALLET_PASSWORD="WalletTest_2024#"
TEST_TRIGGER_PASSWORD="DgAdmin_2024#"
TEST_DB_MEMORY_MB=1024                   # the VMs have 4 GB; cdb1 stays up
TEST_DB_CHARSET="AL32UTF8"
FSFO_THRESHOLD=30

# --- Behaviour ---
CLEANUP_ON_FAILURE="false"
STEP_TIMEOUT=3600

# --- Legacy keys, read only by the old run_e2e_test.sh (to be retired) ---
TEST_DB_NAME="dgtest"
TEST_DB_UNIQUE_NAME="dgtest"
TEST_STANDBY_DB_UNIQUE_NAME="dgtest_s"
TEST_REDO_SIZE_MB=200
TEST_DATA_DIR="${ORACLE_BASE}/oradata/${TEST_DB_NAME}"
TEST_ARCHIVE_DIR="${ORACLE_BASE}/archive/${TEST_DB_NAME}"
SKIP_FSFO="false"
SKIP_OBSERVER="false"
SKIP_TRIGGER="false"
SKIP_MAXAVAIL="false"
CLEANUP_ON_SUCCESS="true"
