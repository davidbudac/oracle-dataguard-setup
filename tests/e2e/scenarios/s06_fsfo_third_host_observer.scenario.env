# S06 - FSFO on a CDB with the observer on the THIRD host: step 9 routes to
# add_observer/01_prepare_primary.sh, the bundle is installed on HOST3 and
# driven through 02/03/04, the observer user is C##-prefixed. Failover proof as S05.
S_ID="s06"
S_TITLE="FSFO on a CDB, observer on the third host (add_observer bundle), CDB role trigger, failover proof"
S_TIER="full"
S_KIND="build"
S_PRIMARY="p04"
S_PRIMARY_OVERRIDES="P_FLASHBACK=yes P_FRA_DIR={FS1}/e2e/fra_dgcdb P_FRA_SIZE_GB=10"
WANT_STANDBY_DB_UNIQUE_NAME="dgcdb_s"
WANT_STORAGE_MODE="traditional"
WANT_STANDBY_FRA="{FS1}/e2e/fra_dgcdb_s:10"
WANT_PROTECTION="maxavail"
WANT_FSFO="yes"
WANT_OBSERVER="third-host"
WANT_STANDBY_FLASHBACK="yes"
WANT_ROLE_TRIGGER="cdb"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"
PROVE_REDO_ROUNDTRIP="yes"
PROVE_FAILOVER="yes"
EXPECT_STATUS_EXIT="0"
EXPECT_WARNINGS=""
