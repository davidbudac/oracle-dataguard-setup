# S08 - CDB with OMF (P05) to an OMF standby, CDB role trigger; a PDB created
# after the setup must arrive with no operator action.
S_ID="s08"
S_TITLE="CDB with OMF, CDB role trigger, new PDB"
S_TIER="full"
S_KIND="build"
S_PRIMARY="p05"
WANT_STANDBY_DB_UNIQUE_NAME="dgcomf_s"
WANT_STORAGE_MODE="omf"
WANT_OMF_FILE_DEST="{FS1}/e2e/omf_cdb_stby"
WANT_STANDBY_FRA="{FS1}/e2e/fra_cdb_stby:10"
WANT_PROTECTION="maxperf"
WANT_ROLE_TRIGGER="cdb"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"
PROVE_REDO_ROUNDTRIP="yes"
PROVE_NEW_PDB="yes"
EXPECT_STATUS_EXIT="1"
EXPECT_WARNINGS="Flashback is 'NO' on (primary|standby)|Fast-Start Failover is Disabled"
