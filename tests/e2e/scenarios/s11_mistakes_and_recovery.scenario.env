# S11 - mistakes and recovery: a wrong standby data directory entered in step 2
# and corrected by editing the .env arrays + --regenerate; SYS locked when step
# 5 first runs (ORA-28000, the documented fix); RMAN killed mid-duplicate and
# the documented restart procedure; step 6 re-run over the existing configuration.
S_ID="s11"
S_TITLE="Mistakes and recovery: wrong path in step 2, locked SYS, killed duplicate, step 6 re-run"
S_TIER="full"
S_KIND="build"
S_PRIMARY="p01"
WANT_STANDBY_DB_UNIQUE_NAME="dgtest_s"
WANT_STORAGE_MODE="traditional"
WANT_STEP2_MISTAKE="${ORACLE_BASE}/oradata/DGTEST=${ORACLE_BASE}/oradata/WRONG_DIR"
WANT_STEP2_MISTAKE_FIX="${ORACLE_BASE}/oradata/DGTEST_S"
WANT_PROTECTION="maxperf"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"
INJECT_FAULTS="lock-sys-before-step5 kill-rman-during-step5"
PROVE_REDO_ROUNDTRIP="yes"
EXPECT_STATUS_EXIT="1"
EXPECT_WARNINGS="Flashback is 'NO' on (primary|standby)|Fast-Start Failover is Disabled"
