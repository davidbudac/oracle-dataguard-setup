# Scenario S11 - operator mistakes and harness-injected faults; the documented recovery must end in a healthy standby.

S_ID="s11"
S_TITLE="Mistakes and recovery: wrong path in step 2, locked SYS, killed duplicate, step 6 re-run"
S_TIER="full"
S_KIND="build"
S_PRIMARY="p01"
S_PRIMARY_OVERRIDES=""

WANT_STANDBY_DB_UNIQUE_NAME="dgtest_s"
WANT_STANDBY_SID=""

WANT_STORAGE_MODE="traditional"
WANT_FS_MAP=""
WANT_PATH_OVERRIDES=""
WANT_SEPARATE_SRL_DIR=""
WANT_CONTROL_FILE_2_DIR=""
WANT_STANDBY_ORACLE_BASE=""
WANT_STANDBY_FRA="none"
WANT_OMF_FILE_DEST=""
WANT_ONLINE_LOG_DESTS=""

WANT_CHECK_MODE_FIRST="no"

WANT_CLONE_CHANNELS=""
WANT_CLONE_RATE=""

WANT_PROTECTION="maxperf"
WANT_FSFO="no"
WANT_OBSERVER="none"
WANT_STANDBY_FLASHBACK="no"
WANT_ROLE_TRIGGER="none"
WANT_NEW_SERVICES=""
WANT_WALLET="no"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"

OPERATOR_NOTES="In step 2, first enter a wrong standby datafile directory and accept it. Then notice it in the review, correct it by editing the path arrays in the generated standby_config .env and running step 2 with --regenerate, then re-run steps 3 and 4. After the standby is healthy, re-run step 6 over the existing broker configuration."

INJECT_FAULTS="lock-sys-before-step5 kill-rman-during-step5"
EXPECT_FAULT_OUTPUT="SYS account on the primary is LOCKED \(ORA-28000\)|||RMAN duplicate failed with exit code"

PROVE_REDO_ROUNDTRIP="yes"
PROVE_SWITCHOVER="none"
PROVE_FAILOVER="no"
PROVE_ADD_DATAFILE="no"
PROVE_NEW_PDB="no"
PROVE_STEP5_DECLINE="no"

EXPECT_STATUS_EXIT="0"
EXPECT_WARNINGS=""
EXPECT_TRANSCRIPT_MATCH=""

CASE_COUNT="0"
