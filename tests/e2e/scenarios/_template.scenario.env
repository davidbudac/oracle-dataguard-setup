# =============================================================================
# Scenario template - copy to sNN_<name>.scenario.env and fill in
# =============================================================================
# One standby build on one primary profile. WANT_* is what the operator is asked
# to achieve: the brief is rendered from it and the assertions are derived from
# it. Leave a WANT_* key empty to mean "take the script's default"; the brief
# then says so and nothing is asserted for it.
# =============================================================================

S_ID=""                       # s02
S_TITLE=""
S_TIER="full"                 # smoke | core | full
S_KIND="build"                # build | refusal
S_PRIMARY=""                  # profile id, e.g. p02
S_PRIMARY_OVERRIDES=""        # profile keys changed for this scenario only: "P_FLASHBACK=yes P_PRESET_CONVERT=log"

# --- Standby identity ---
WANT_STANDBY_DB_UNIQUE_NAME=""
WANT_STANDBY_SID=""           # empty = script default

# --- Standby storage ---
WANT_STORAGE_MODE=""          # traditional | omf
WANT_FS_MAP=""                # traditional: "/u02=/u04 /u03=/mnt/oracle/u03" (Q1b); empty = same names
WANT_PATH_OVERRIDES=""        # traditional: "<primary dir>=<standby dir> ..." set in the review table
WANT_SEPARATE_SRL_DIR=""      # directory, or empty = with the online redo logs
WANT_CONTROL_FILE_2_DIR=""    # directory, or empty = both copies together
WANT_STANDBY_ORACLE_BASE=""   # empty = same as primary
WANT_STANDBY_FRA=""           # none | "<dir>:<size GB>"
WANT_OMF_FILE_DEST=""         # omf: db_create_file_dest on the standby
WANT_ONLINE_LOG_DESTS=""      # omf: "1=<dir> 2=<dir>"; empty = script defaults

# --- How the operator works ---
WANT_CHECK_MODE_FIRST="no"    # yes = run every step with -n first, then for real

# --- Clone ---
WANT_CLONE_CHANNELS=""        # step 5 --channels
WANT_CLONE_RATE=""            # step 5 --rate

# --- After the build ---
WANT_PROTECTION="maxperf"     # maxperf | maxavail (step 13, or via step 9)
WANT_FSFO="no"                # yes | no (step 9)
WANT_OBSERVER="none"          # none | standby-host | third-host
WANT_STANDBY_FLASHBACK="no"   # yes = operator turns Flashback Database on on the standby (no script does it)
WANT_ROLE_TRIGGER="none"      # none | sys | dedicated | cdb
WANT_NEW_SERVICES=""          # created by the operator: "cdb:svc" / "pdb1:svc"
WANT_WALLET="no"              # yes = common/setup_dg_wallet.sh on both hosts
WANT_HANDOFF="yes"            # yes = primary/10_generate_handoff_report.sh
WANT_CLEANUP="default"        # none | default | all (step 12)

# --- Anything the keys above cannot say; given to the operator verbatim ---
OPERATOR_NOTES=""

# --- Faults the harness injects while the operator works (build scenarios) ---
# lock-sys-before-step5    SYS locked on the primary before the first step 5 run
# kill-rman-during-step5   RMAN killed once the duplicate is restoring datafiles
# The operator is not told in advance; it has to recover using the script output
# and the walkthrough.
INJECT_FAULTS=""
EXPECT_FAULT_OUTPUT=""        # one ERE per fault, same order, "|||"-separated

# --- Functional proofs (run by the asserter after the operator is done) ---
PROVE_REDO_ROUNDTRIP="yes"
PROVE_SWITCHOVER="none"       # none | roundtrip
PROVE_FAILOVER="no"           # yes needs WANT_FSFO=yes and an observer
PROVE_ADD_DATAFILE="no"
PROVE_NEW_PDB="no"            # CDB only
PROVE_STEP5_DECLINE="no"      # yes = re-run step 5 on the healthy standby, decline; standby must be untouched

# --- Expectations beyond what WANT_* implies ---
EXPECT_STATUS_EXIT="0"        # dg_status.sh: 0 healthy, 1 = warnings listed below
EXPECT_WARNINGS=""            # patterns that may appear, e.g. "standby flashback"
EXPECT_TRANSCRIPT_MATCH=""    # ERE that must appear in the operator transcript

# --- refusal scenarios only (S_KIND=refusal) ---
# A refusal scenario is a pack of numbered cases run one after another on the
# same primary. The harness applies the setup, the operator runs the step, the
# asserter checks the outcome, the harness restores the setup.
CASE_COUNT="0"
# CASE_1_TITLE=""
# CASE_1_PRIMARY_TOGGLE=""    # none | noarchivelog | no-force-logging | pwfile-shared
# CASE_1_CONFIG_TAMPER=""     # none | wrong-dbid  (edits the build's standby_config_*.env in place, restored after the case)
# CASE_1_PREREQ_STEPS=""      # steps the harness completes non-interactively first, e.g. "1 2"
# CASE_1_HOST=""              # primary | standby: where the operator runs the step
# CASE_1_STEP=""              # script that must refuse, e.g. primary/01_gather_primary_info.sh
# CASE_1_ARGS=""
# CASE_1_OPERATOR_NOTES=""    # what the operator should try to do, e.g. "choose OMF mode"
# CASE_1_EXIT=""              # expected exit code (0 = the step must warn and carry on)
# CASE_1_MATCH=""             # ERE that must appear in the output (taken from the script text)
# CASE_1_UNCHANGED="share primary-params"   # what must be identical before/after; "share" ignores logs/ and state/
