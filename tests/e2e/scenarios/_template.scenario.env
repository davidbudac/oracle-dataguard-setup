# =============================================================================
# Scenario template - copy to sNN_<name>.scenario.env and fill in
# =============================================================================
# One standby build on one primary profile. WANT_* is what a DBA would be
# asked to achieve: the harness answers every prompt from these keys (by
# prompt text, not by position - see lib/build.sh derive_answers and the
# answers/*.rules files) and the assertions are derived from the same keys.
# An empty WANT_* key means "take the script's default" and asserts nothing.
#
# Placeholders: {FS1} {FS2} {FS3} {FSn:fs} {RENAME} {SCRATCH} and ${ORACLE_BASE}
# (see primaries/_template.env). Prerequisites are derived automatically into
# S_NEEDS (fs2/fs3, rename-target, obase-sibling, host3, mem1g/mem2g,
# flashback-space); add extra tokens in S_NEEDS if a scenario needs more.
# =============================================================================

S_ID=""                       # s02
S_TITLE=""
S_TIER="full"                 # smoke | core | full
S_KIND="build"                # build | refusal
S_PRIMARY=""                  # profile id, e.g. p02
S_PRIMARY_OVERRIDES=""        # profile keys changed for this scenario only: "P_FLASHBACK=yes P_FRA_DIR={FS1}/e2e/fra"
S_NET="scratch"               # scratch = own TNS_ADMIN + listener on LAB_SCRATCH_PORT (never touches the shared
                              # network/admin); shared = the real $ORACLE_HOME/network/admin and the default listener
S_NEEDS=""                    # extra prerequisites (see lib/doctor.sh)

# --- Standby identity ---
WANT_STANDBY_DB_UNIQUE_NAME=""
WANT_STANDBY_SID=""           # empty = script default (the primary's SID)

# --- Standby storage ---
WANT_STORAGE_MODE=""          # traditional | omf
WANT_FS_MAP=""                # traditional: "{FS2:fs}={RENAME} /u03=/u06" (Q1b, first components); empty = same names
WANT_PATH_OVERRIDES=""        # traditional: "<primary dir>=<standby dir> ..." entered in the review table
WANT_SEPARATE_SRL_DIR=""      # directory, or empty = with the online redo logs
WANT_CONTROL_FILE_2_DIR=""    # directory, or empty = both copies together
WANT_STANDBY_ORACLE_BASE=""   # empty = same as primary
WANT_STANDBY_FRA=""           # none | "<dir>:<size GB>"
WANT_STANDBY_ARCHIVE_DIR=""   # traditional without FRA: explicit archive dir; empty = derived default
WANT_OMF_FILE_DEST=""         # omf: db_create_file_dest on the standby
WANT_ONLINE_LOG_DESTS=""      # omf: "1=<dir> 2=<dir>"; empty = script defaults

# --- How the operator works ---
WANT_CHECK_MODE_FIRST="no"    # yes = run every step with -n first and prove nothing changed
WANT_STEP2_MISTAKE=""         # "<primary dir>=<wrong standby dir>": entered in step 2's review table, then
WANT_STEP2_MISTAKE_FIX=""     # corrected by editing the .env and --regenerate (the right standby dir)

# --- Clone ---
WANT_CLONE_CHANNELS=""        # step 5 --channels
WANT_CLONE_RATE=""            # step 5 --rate

# --- After the build ---
WANT_PROTECTION="maxperf"     # maxperf | maxavail (step 13, or via step 9)
WANT_FSFO="no"                # yes | no (step 9)
WANT_OBSERVER="none"          # none | standby-host | third-host
WANT_STANDBY_FLASHBACK="no"   # yes = Flashback Database on on the standby (operator action, needs WANT_STANDBY_FRA)
WANT_ROLE_TRIGGER="none"      # none | sys | dedicated | cdb
WANT_NEW_SERVICES=""          # created with trigger/create_*_service.sh: "cdb:svc" / "pdb1:svc"
WANT_WALLET="no"              # yes = common/setup_dg_wallet.sh on both hosts
WANT_HANDOFF="yes"            # yes = primary/10_generate_handoff_report.sh
WANT_CLEANUP="default"        # none | default | all (step 12, run after checks and proofs)

# --- Faults injected while the steps run ---
# lock-sys-before-step5    SYS locked on the primary before the first step 5 run
# kill-rman-during-step5   RMAN killed once the duplicate is running
INJECT_FAULTS=""

# --- Functional proofs (after checks) ---
PROVE_REDO_ROUNDTRIP="yes"
PROVE_SWITCHOVER="none"       # none | roundtrip
PROVE_FAILOVER="no"           # yes needs WANT_FSFO=yes, an observer and flashback on both
PROVE_ADD_DATAFILE="no"
PROVE_NEW_PDB="no"            # CDB only
PROVE_UNCOVERED_DIR="no"      # traditional: datafile in an uncovered dir -> UNNAMED -> documented fix
PROVE_STEP5_DECLINE="no"      # yes = re-run step 5 on the healthy standby, decline; standby untouched

# --- Expectations beyond what WANT_* implies ---
EXPECT_STATUS_EXIT="0"        # dg_status.sh: 0 healthy, 1 = warnings listed below
EXPECT_WARNINGS=""            # ERE that must appear in the dg_status.sh output when exit 1 is expected

# --- refusal scenarios only (S_KIND=refusal) ---
# A refusal scenario is a pack of numbered cases run one after another on the
# same primary. The harness applies the setup, drives the step, checks the
# outcome, restores the setup.
CASE_COUNT="0"
# CASE_1_TITLE=""
# CASE_1_PRIMARY_TOGGLE=""    # none | noarchivelog | no-force-logging | pwfile-shared
# CASE_1_CONFIG_TAMPER=""     # none | wrong-dbid  (edits the build's standby_config_*.env, restored after the case)
# CASE_1_PREREQ_STEPS=""      # steps the harness completes first with the normal answers, e.g. "1 2"
# CASE_1_HOST=""              # primary | standby: where the step runs
# CASE_1_STEP=""              # script that must refuse, e.g. primary/01_gather_primary_info.sh
# CASE_1_ARGS=""
# CASE_1_ANSWERS=""           # extra prompt rules for this case, "regex<TAB>answer" entries separated by |
# CASE_1_OPERATOR_NOTES=""    # what is being attempted, for the log
# CASE_1_EXIT=""              # expected exit code (0 = the step must warn and carry on)
# CASE_1_MATCH=""             # ERE that must appear in the output (taken from the script text)
# CASE_1_UNCHANGED="share primary-params"   # what must be identical before/after: share, primary-params, standby-instance
