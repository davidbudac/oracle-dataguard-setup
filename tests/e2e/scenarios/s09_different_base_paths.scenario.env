# S09 - same filesystem names, different directories below them: every data and
# redo directory is overridden in the review table, the standby ORACLE_BASE
# differs (needs the sibling of ORACLE_BASE writable), standby FRA, rate-limited clone.
S_ID="s09"
S_TITLE="Different base paths: review-table overrides, other ORACLE_BASE, standby FRA, rate-limited clone"
S_TIER="full"
S_KIND="build"
S_PRIMARY="p02"
WANT_STANDBY_DB_UNIQUE_NAME="dgspr_s"
WANT_STORAGE_MODE="traditional"
WANT_PATH_OVERRIDES="{FS1}/e2e/oradata/DGSPR={FS1}/e2e_stby/data_a {FS2}/e2e/oradata2/DGSPR={FS2}/e2e_stby/data_b {FS3}/e2e/redo={FS3}/e2e_stby/redo_a {FS2}/e2e/redo2={FS2}/e2e_stby/redo_b"
WANT_STANDBY_ORACLE_BASE="${ORACLE_BASE}_stby"
WANT_STANDBY_FRA="{FS2}/e2e_stby/fra:10"
WANT_CLONE_RATE="50M"
WANT_PROTECTION="maxperf"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"
PROVE_REDO_ROUNDTRIP="yes"
PROVE_ADD_DATAFILE="yes"
EXPECT_STATUS_EXIT="1"
EXPECT_WARNINGS="Flashback is 'NO' on (primary|standby)|Fast-Start Failover is Disabled"
