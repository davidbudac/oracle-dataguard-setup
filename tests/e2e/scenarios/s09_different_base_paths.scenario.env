# Scenario S09 - same filesystem names on the standby, different directories below them; other ORACLE_BASE; rate limit.

S_ID="s09"
S_TITLE="Different base paths: review-table overrides, other ORACLE_BASE, standby FRA, rate-limited clone"
S_TIER="full"
S_KIND="build"
S_PRIMARY="p02"
S_PRIMARY_OVERRIDES=""

WANT_STANDBY_DB_UNIQUE_NAME="dgspr_s"
WANT_STANDBY_SID=""

WANT_STORAGE_MODE="traditional"
WANT_FS_MAP=""
WANT_PATH_OVERRIDES="/u02/oradata/DGSPR=/u02/stby/data_a /u03/oradata/DGSPR=/u03/stby/data_b /u04/redo=/u04/stby/redo_a /u05/redo=/u05/stby/redo_b"
WANT_SEPARATE_SRL_DIR=""
WANT_CONTROL_FILE_2_DIR=""
WANT_STANDBY_ORACLE_BASE="/u01/app/oracle_stby"
WANT_STANDBY_FRA="/u05/fra_stby:20"
WANT_OMF_FILE_DEST=""
WANT_ONLINE_LOG_DESTS=""

WANT_CHECK_MODE_FIRST="no"

WANT_CLONE_CHANNELS=""
WANT_CLONE_RATE="50M"

WANT_PROTECTION="maxperf"
WANT_FSFO="no"
WANT_OBSERVER="none"
WANT_STANDBY_FLASHBACK="no"
WANT_ROLE_TRIGGER="none"
WANT_NEW_SERVICES=""
WANT_WALLET="no"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"

OPERATOR_NOTES="The filesystems have the same names on the standby host, but the directories below them differ. Set them in the path review table."

INJECT_FAULTS=""
EXPECT_FAULT_OUTPUT=""

PROVE_REDO_ROUNDTRIP="yes"
PROVE_SWITCHOVER="none"
PROVE_FAILOVER="no"
PROVE_ADD_DATAFILE="no"
PROVE_NEW_PDB="no"
PROVE_STEP5_DECLINE="no"

EXPECT_STATUS_EXIT="0"
EXPECT_WARNINGS=""
EXPECT_TRANSCRIPT_MATCH=""

CASE_COUNT="0"
