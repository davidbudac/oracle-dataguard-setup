# R02 - OMF mode refused on a primary with log_file_name_convert set: step 2 must
# exit 1 as soon as OMF is chosen, before the OMF directory prompts, and write nothing.
S_ID="r02"
S_TITLE="OMF blocked by an inherited convert parameter"
S_TIER="core"
S_KIND="refusal"
S_PRIMARY="p01"
S_PRIMARY_OVERRIDES="P_PRESET_CONVERT=log"
CASE_COUNT="1"
CASE_1_TITLE="OMF mode with log_file_name_convert set"
CASE_1_PREREQ_STEPS="1"
CASE_1_HOST="primary"
CASE_1_STEP="primary/02_generate_standby_config.sh"
CASE_1_ANSWERS="Storage mode \[1\]:<TAB>2"
CASE_1_OPERATOR_NOTES="Run step 2 and ask for an OMF standby when the storage mode question comes."
CASE_1_EXIT="1"
CASE_1_MATCH="log_file_name_convert"
CASE_1_UNCHANGED="share primary-params"
