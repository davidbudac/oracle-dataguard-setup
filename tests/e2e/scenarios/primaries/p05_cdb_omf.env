# Primary profile P05 - CDB with two PDBs and Oracle Managed Files (PDB files in GUID directories).
# Hosts, Oracle paths and passwords come from ../config.env.

P_ID="p05"
P_DESC="CDB + 2 PDBs, OMF with FRA, no online-log destinations"

P_DB_NAME="dgcomf"
P_SID=""
P_DB_UNIQUE_NAME=""
P_DB_DOMAIN=""
P_NAMES_DEFAULT_DOMAIN=""
P_LISTENER_PORT="1521"

P_CDB="yes"
P_PDBS="pdb1 pdb2"
P_SERVICES="pdb1:app1_svc"

P_STORAGE="omf"
P_DATA_DIRS=""
P_REDO_DIRS=""
P_TEMP_DIR=""
P_CONTROL_FILES=""
P_OMF_FILE_DEST="${ORACLE_BASE}/oradata_comf"
P_OMF_ONLINE_LOG_DEST_1=""
P_OMF_ONLINE_LOG_DEST_2=""
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"

P_FRA_DIR="${ORACLE_BASE}/fra_comf"
P_FRA_SIZE_GB="20"
P_ARCHIVE_DEST="FRA"

P_ARCHIVELOG="yes"
P_FORCE_LOGGING="yes"
P_PWFILE="exclusive"
P_FLASHBACK="no"

P_PRE_SRL="none"
P_PRE_SRL_THREAD="explicit"
P_BROKER_FILE_DIR=""
P_PRESET_CONVERT=""

P_SEED_MB="0"
P_LOAD_DURING_CLONE="no"
P_POST_SQL=""
