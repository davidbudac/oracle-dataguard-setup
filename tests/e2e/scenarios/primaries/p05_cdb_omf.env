# P05 - CDB + 2 PDBs, OMF (GUID directories), FRA. Opens: OMF with PDB GUID paths.
P_ID="p05"
P_DESC="CDB + 2 PDBs, OMF with FRA, no online-log destinations"
P_DB_NAME="dgcomf"
P_MEMORY_MB="1800"
P_CDB="yes"
P_PDBS="pdb1 pdb2"
P_SERVICES="pdb1:app1_svc"
P_STORAGE="omf"
P_OMF_FILE_DEST="{FS1}/e2e/omf_cdb"
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"
P_FRA_DIR="{FS1}/e2e/fra_cdb"
P_FRA_SIZE_GB="10"
P_ARCHIVE_DEST="FRA"
