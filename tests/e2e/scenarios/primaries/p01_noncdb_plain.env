# P01 - the default shape: non-CDB, explicit paths, data and redo in one
# directory, no FRA, one user service. Cheapest to build: hosts the smoke,
# FSFO, recovery and refusal scenarios.
P_ID="p01"
P_DESC="non-CDB, explicit paths, data and redo in one directory, no FRA"
P_DB_NAME="dgtest"
P_CDB="no"
P_SERVICES="dgtest_app"
P_STORAGE="explicit"
P_DATA_DIRS="${ORACLE_BASE}/oradata/DGTEST"
P_REDO_DIRS="${ORACLE_BASE}/oradata/DGTEST"
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"
P_ARCHIVE_DEST="${ORACLE_BASE}/archive/dgtest"
P_ARCHIVELOG="yes"
P_FORCE_LOGGING="yes"
P_PWFILE="exclusive"
P_FLASHBACK="no"
