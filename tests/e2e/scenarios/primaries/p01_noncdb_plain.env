# Primary profile P01 - the shape run_e2e_test.sh builds today.
# Hosts, Oracle paths and passwords come from ../config.env.

P_ID="p01"
P_DESC="non-CDB, explicit paths, data and redo in one directory, no FRA"

P_DB_NAME="dgtest"
P_SID=""
P_DB_UNIQUE_NAME=""
P_DB_DOMAIN=""
P_NAMES_DEFAULT_DOMAIN=""
P_LISTENER_PORT="1521"

P_CDB="no"
P_PDBS=""
P_SERVICES="dgtest_app"

P_STORAGE="explicit"
P_DATA_DIRS="${ORACLE_BASE}/oradata/DGTEST"
P_REDO_DIRS="${ORACLE_BASE}/oradata/DGTEST"
P_TEMP_DIR=""
P_CONTROL_FILES=""            # DBCA default placement
P_OMF_FILE_DEST=""
P_OMF_ONLINE_LOG_DEST_1=""
P_OMF_ONLINE_LOG_DEST_2=""
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"

P_FRA_DIR=""
P_FRA_SIZE_GB=""
P_ARCHIVE_DEST="${ORACLE_BASE}/archive/dgtest"

P_ARCHIVELOG="yes"
P_FORCE_LOGGING="yes"
P_PWFILE="exclusive"
P_FLASHBACK="no"

P_PRE_SRL="none"
P_PRE_SRL_THREAD="explicit"
P_BROKER_FILE_DIR=""
P_PRESET_CONVERT=""

P_SEED_MB="0"
P_LOAD_DURING_CLONE="no"
P_POST_SQL=""
