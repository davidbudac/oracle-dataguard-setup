# Primary profile P02 - non-CDB spread over several filesystems, multiplexed redo, FRA.
# Hosts, Oracle paths and passwords come from ../config.env.

P_ID="p02"
P_DESC="non-CDB, data on /u02 and /u03, redo on /u04 and /u05 (no DB name in the path), explicit control files, FRA with archiving into it"

P_DB_NAME="dgspr"
P_SID=""
P_DB_UNIQUE_NAME=""
P_DB_DOMAIN=""
P_NAMES_DEFAULT_DOMAIN=""
P_LISTENER_PORT="1521"

P_CDB="no"
P_PDBS=""
P_SERVICES="dgspr_app"

P_STORAGE="explicit"
P_DATA_DIRS="/u02/oradata/DGSPR /u03/oradata/DGSPR"
P_REDO_DIRS="/u04/redo /u05/redo"
P_TEMP_DIR="/u02/temp/DGSPR"
P_CONTROL_FILES="/u02/oradata/DGSPR/control01.ctl /u04/redo/control02.ctl"
P_OMF_FILE_DEST=""
P_OMF_ONLINE_LOG_DEST_1=""
P_OMF_ONLINE_LOG_DEST_2=""
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"

P_FRA_DIR="/u05/fra"
P_FRA_SIZE_GB="20"
P_ARCHIVE_DEST="FRA"

P_ARCHIVELOG="yes"
P_FORCE_LOGGING="yes"
P_PWFILE="exclusive"
P_FLASHBACK="no"

P_PRE_SRL="none"
P_PRE_SRL_THREAD="explicit"
P_BROKER_FILE_DIR=""
P_PRESET_CONVERT=""

P_SEED_MB="200"
P_LOAD_DURING_CLONE="yes"
P_POST_SQL=""
