# P02 - non-CDB spread over three "filesystems" (distinct first path
# components): datafiles on {FS1} and {FS2}, multiplexed redo on {FS3} and
# {FS2} with NO DB-name component in the path, temp separate, explicit control
# files in two places, FRA on {FS2} with archiving into it. Opens: convert
# pairs over several directories, Q1b, the unmapped-path confirmation,
# inherited FRA and control_files in step 5.
P_ID="p02"
P_DESC="non-CDB, data on {FS1}+{FS2}, redo on {FS3}+{FS2} (no DB name in the path), explicit control files, FRA with archiving into it"
P_DB_NAME="dgspr"
P_CDB="no"
P_SERVICES="dgspr_app"
P_STORAGE="explicit"
P_DATA_DIRS="{FS1}/e2e/oradata/DGSPR {FS2}/e2e/oradata2/DGSPR"
P_REDO_DIRS="{FS3}/e2e/redo {FS2}/e2e/redo2"
P_TEMP_DIR="{FS2}/e2e/temp/DGSPR"
P_CONTROL_FILES="{FS1}/e2e/oradata/DGSPR/control01.ctl {FS3}/e2e/redo/control02.ctl"
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"
P_FRA_DIR="{FS2}/e2e/fra"
P_FRA_SIZE_GB="10"
P_ARCHIVE_DEST="FRA"
P_SEED_MB="100"
P_LOAD_DURING_CLONE="yes"
