# P03 - non-CDB, OMF: db_create_file_dest plus db_create_online_log_dest_1/2
# and a FRA. Opens: inherited placement parameters, the
# STANDBY_DB_CREATE_ONLINE_LOG_DEST_n mapping.
P_ID="p03"
P_DESC="non-CDB, OMF with db_create_online_log_dest_1/2 and FRA"
P_DB_NAME="dgomf"
P_CDB="no"
P_SERVICES="dgomf_app"
P_STORAGE="omf"
P_OMF_FILE_DEST="{FS1}/e2e/omf"
P_OMF_ONLINE_LOG_DEST_1="{FS2}/e2e/oralog_a"
P_OMF_ONLINE_LOG_DEST_2="{FS1}/e2e/oralog_b"
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"
P_FRA_DIR="{FS1}/e2e/fra_omf"
P_FRA_SIZE_GB="10"
P_ARCHIVE_DEST="FRA"
