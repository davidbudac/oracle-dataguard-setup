# Primary profile P03 - non-CDB with Oracle Managed Files, two online-log destinations, FRA.
# Hosts, Oracle paths and passwords come from ../config.env.

P_ID="p03"
P_DESC="non-CDB, OMF with db_create_online_log_dest_1/2 and FRA"

P_DB_NAME="dgomf"
P_SID=""
P_DB_UNIQUE_NAME=""
P_DB_DOMAIN=""
P_NAMES_DEFAULT_DOMAIN=""
P_LISTENER_PORT="1521"

P_CDB="no"
P_PDBS=""
P_SERVICES="dgomf_app"

P_STORAGE="omf"
P_DATA_DIRS=""
P_REDO_DIRS=""
P_TEMP_DIR=""
P_CONTROL_FILES=""
P_OMF_FILE_DEST="${ORACLE_BASE}/oradata_omf"
P_OMF_ONLINE_LOG_DEST_1="${ORACLE_BASE}/oralog_a"
P_OMF_ONLINE_LOG_DEST_2="${ORACLE_BASE}/oralog_b"
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"

P_FRA_DIR="${ORACLE_BASE}/fra_omf"
P_FRA_SIZE_GB="20"
P_ARCHIVE_DEST="FRA"

P_ARCHIVELOG="yes"
P_FORCE_LOGGING="yes"
P_PWFILE="exclusive"
P_FLASHBACK="no"

P_PRE_SRL="none"
P_PRE_SRL_THREAD="explicit"
P_BROKER_FILE_DIR=""
P_PRESET_CONVERT=""

P_SEED_MB="0"
P_LOAD_DURING_CLONE="no"
P_POST_SQL=""
