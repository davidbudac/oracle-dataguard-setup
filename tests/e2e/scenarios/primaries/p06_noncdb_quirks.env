# Primary profile P06 - SID, DB_NAME and DB_UNIQUE_NAME all differ; listener on 1531; undersized SRLs without THREAD.
# Hosts, Oracle paths and passwords come from ../config.env.

P_ID="p06"
P_DESC="non-CDB, SID dgq1 / DB_NAME dgqrk / DB_UNIQUE_NAME dgqrk_a, port 1531, undersized SRLs at THREAD#=0, non-default broker files"

P_DB_NAME="dgqrk"
P_SID="dgq1"
P_DB_UNIQUE_NAME="dgqrk_a"
P_DB_DOMAIN=""
P_NAMES_DEFAULT_DOMAIN=""
P_LISTENER_PORT="1531"

P_CDB="no"
P_PDBS=""
P_SERVICES="dgqrk_app"

P_STORAGE="explicit"
P_DATA_DIRS="${ORACLE_BASE}/oradata/DGQRK"
P_REDO_DIRS="${ORACLE_BASE}/oradata/DGQRK"
P_TEMP_DIR=""
P_CONTROL_FILES=""
P_OMF_FILE_DEST=""
P_OMF_ONLINE_LOG_DEST_1=""
P_OMF_ONLINE_LOG_DEST_2=""
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"

P_FRA_DIR=""
P_FRA_SIZE_GB=""
P_ARCHIVE_DEST="${ORACLE_BASE}/archive/dgqrk"

P_ARCHIVELOG="yes"
P_FORCE_LOGGING="yes"
P_PWFILE="exclusive"
P_FLASHBACK="no"

P_PRE_SRL="undersized"
P_PRE_SRL_THREAD="none"
P_BROKER_FILE_DIR="${ORACLE_BASE}/broker/dgqrk"
P_PRESET_CONVERT=""

P_SEED_MB="0"
P_LOAD_DURING_CLONE="no"
P_POST_SQL=""
