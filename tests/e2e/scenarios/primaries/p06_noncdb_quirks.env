# P06 - the quirks: SID != DB_NAME != DB_UNIQUE_NAME, listener on port 1541,
# undersized SRLs created without a THREAD clause (THREAD#=0), non-default
# dg_broker_config_file1/2. Opens: name handling, port detection, the SRL
# size warning (nothing dropped), broker-file SPFILE SET in step 5.
P_ID="p06"
P_DESC="non-CDB, SID dgq1 / DB_NAME dgqrk / DB_UNIQUE_NAME dgqrk_a, port 1541, undersized SRLs at THREAD#=0, non-default broker files"
P_DB_NAME="dgqrk"
P_SID="dgq1"
P_DB_UNIQUE_NAME="dgqrk_a"
P_LISTENER_PORT="1541"
P_CDB="no"
P_SERVICES="dgqrk_app"
P_STORAGE="explicit"
P_DATA_DIRS="${ORACLE_BASE}/oradata/DGQRK_A"
P_REDO_DIRS="${ORACLE_BASE}/oradata/DGQRK_A"
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"
P_ARCHIVE_DEST="${ORACLE_BASE}/archive/dgqrk_a"
P_PRE_SRL="undersized"
P_PRE_SRL_THREAD="none"
P_BROKER_FILE_DIR="{FS1}/e2e/broker/dgqrk"
