# Primary profile P04 - CDB with two PDBs, explicit paths, db_domain and NAMES.DEFAULT_DOMAIN set.
# Hosts, Oracle paths and passwords come from ../config.env.

P_ID="p04"
P_DESC="CDB + 2 PDBs, explicit paths, db_domain world, one user service per PDB, no FRA"

P_DB_NAME="dgcdb"
P_SID=""
P_DB_UNIQUE_NAME=""
P_DB_DOMAIN="world"
P_NAMES_DEFAULT_DOMAIN="world"
P_LISTENER_PORT="1521"

P_CDB="yes"
P_PDBS="pdb1 pdb2"
P_SERVICES="pdb1:app1_svc pdb2:app2_svc"

P_STORAGE="explicit"
P_DATA_DIRS="${ORACLE_BASE}/oradata/DGCDB"
P_REDO_DIRS="${ORACLE_BASE}/oradata/DGCDB"
P_TEMP_DIR=""
P_CONTROL_FILES=""
P_OMF_FILE_DEST=""
P_OMF_ONLINE_LOG_DEST_1=""
P_OMF_ONLINE_LOG_DEST_2=""
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"

P_FRA_DIR=""
P_FRA_SIZE_GB=""
P_ARCHIVE_DEST="${ORACLE_BASE}/archive/dgcdb"

P_ARCHIVELOG="yes"
P_FORCE_LOGGING="yes"
P_PWFILE="exclusive"
P_FLASHBACK="no"

P_PRE_SRL="none"
P_PRE_SRL_THREAD="explicit"
P_BROKER_FILE_DIR=""
P_PRESET_CONVERT=""

P_SEED_MB="0"
P_LOAD_DURING_CLONE="no"
P_POST_SQL=""
