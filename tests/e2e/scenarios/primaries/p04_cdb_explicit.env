# P04 - CDB + 2 PDBs, explicit paths (PDB subdirectories), db_domain and
# NAMES.DEFAULT_DOMAIN, one user service per PDB. Opens: alias domain
# qualification, the C## observer user, the CDB trigger, PDB services.
P_ID="p04"
P_DESC="CDB + 2 PDBs, explicit paths, db_domain world, one user service per PDB, no FRA"
P_DB_NAME="dgcdb"
P_DB_DOMAIN="world"
P_NAMES_DEFAULT_DOMAIN="world"
P_MEMORY_MB="1800"
P_CDB="yes"
P_PDBS="pdb1 pdb2"
P_SERVICES="pdb1:app1_svc pdb2:app2_svc"
P_STORAGE="explicit"
P_DATA_DIRS="${ORACLE_BASE}/oradata/DGCDB"
P_REDO_DIRS="${ORACLE_BASE}/oradata/DGCDB"
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"
P_ARCHIVE_DEST="${ORACLE_BASE}/archive/dgcdb"
