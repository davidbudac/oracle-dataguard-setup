# =============================================================================
# Primary profile template - copy to pNN_<name>.env and fill in
# =============================================================================
# Describes ONE primary database shape. The provisioner (lib/provision.sh)
# builds it with DBCA plus post-SQL and then VERIFIES every property below
# against the live database before the scenario starts. Hosts, Oracle paths
# and passwords come from ../../config.env.
#
# Placeholders: {FS1} {FS2} {FS3} = the lab's writable base directories
# (LAB_FS_SLOTS, distinct FIRST path components - that is what the scripts'
# Q1b calls "a filesystem"); {SCRATCH} = LAB_SCRATCH; ${ORACLE_BASE} expands
# from config.env. A profile that uses {FS2}/{FS3} is skipped on a lab that
# does not provide them (the doctor says what to add).
# =============================================================================

P_ID=""                       # p02
P_DESC=""                     # one line: what makes this shape different

# --- Identity ---
P_DB_NAME=""                  # max 8 chars
P_SID=""                      # empty = same as P_DB_NAME
P_DB_UNIQUE_NAME=""           # empty = same as P_DB_NAME
P_DB_DOMAIN=""                # e.g. world; empty = none
P_NAMES_DEFAULT_DOMAIN=""     # written to the scenario's scratch sqlnet.ora; empty = none
P_LISTENER_PORT="1521"        # scratch-network scenarios get LAB_SCRATCH_PORT when this is 1521
P_MEMORY_MB=""                # empty = TEST_DB_MEMORY_MB (a CDB gets at least 1536)

# --- Architecture ---
P_CDB="no"                    # yes | no
P_PDBS=""                     # space-separated PDB names (CDB only)
P_SERVICES=""                 # user services: "svc1" or "pdb1:svc1 pdb2:svc2" ("cdb:svc" = root)

# --- Storage ---
P_STORAGE="explicit"          # explicit | omf
P_DATA_DIRS=""                # explicit: space-separated; the first holds SYSTEM (DBCA's <dest>/<DB_UNIQUE_NAME> dir)
P_REDO_DIRS=""                # explicit: one dir per member (two dirs = multiplexed)
P_TEMP_DIR=""                 # empty = first data dir
P_CONTROL_FILES=""            # explicit: space-separated full paths; empty = DBCA placement
P_OMF_FILE_DEST=""            # omf: db_create_file_dest
P_OMF_ONLINE_LOG_DEST_1=""    # omf: optional
P_OMF_ONLINE_LOG_DEST_2=""    # omf: optional
P_REDO_GROUPS="3"
P_REDO_SIZE_MB="200"

# --- Recovery area and archiving ---
P_FRA_DIR=""                  # empty = no FRA (flashback needs one)
P_FRA_SIZE_GB=""
P_ARCHIVE_DEST=""             # a directory, or FRA (USE_DB_RECOVERY_FILE_DEST)

# --- Data Guard prerequisites ---
P_ARCHIVELOG="yes"            # yes | no
P_FORCE_LOGGING="yes"         # yes | no
P_PWFILE="exclusive"          # exclusive | shared
P_FLASHBACK="no"              # yes | no (needs P_FRA_DIR)

# --- Pre-existing state the scripts must cope with ---
P_PRE_SRL="none"              # none | ok | undersized
P_PRE_SRL_THREAD="explicit"   # explicit | none (created without a THREAD clause, sits at THREAD#=0)
P_BROKER_FILE_DIR=""          # non-default dg_broker_config_file1/2 directory; empty = default
P_PRESET_CONVERT=""           # db | log | both: convert parameters already set on the primary

# --- Content ---
P_SEED_MB="0"                 # filler rows (MB) in the marker schema created before the build
P_LOAD_DURING_CLONE="no"      # yes = light DML loop while step 5 runs

# --- Escape hatch ---
P_POST_SQL=""                 # file next to this one, run as SYSDBA after everything above
