# R01 - a primary that is not ready: step 1 must refuse NOARCHIVELOG and a SHARED
# password file (exit 1, prerequisite named) and only WARN about missing FORCE
# LOGGING (exit 0; step 4 enables it later). Nothing on the primary may change.
S_ID="r01"
S_TITLE="Not ready: NOARCHIVELOG, no FORCE LOGGING, shared password file"
S_TIER="core"
S_KIND="refusal"
S_PRIMARY="p01"
CASE_COUNT="3"
CASE_1_TITLE="NOARCHIVELOG"
CASE_1_PRIMARY_TOGGLE="noarchivelog"
CASE_1_HOST="primary"
CASE_1_STEP="primary/01_gather_primary_info.sh"
CASE_1_EXIT="1"
CASE_1_MATCH="PREREQUISITE FAILED: Database is NOT in ARCHIVELOG mode"
CASE_1_UNCHANGED="primary-params"
CASE_2_TITLE="No FORCE LOGGING (must warn, not refuse)"
CASE_2_PRIMARY_TOGGLE="no-force-logging"
CASE_2_HOST="primary"
CASE_2_STEP="primary/01_gather_primary_info.sh"
CASE_2_EXIT="0"
CASE_2_MATCH="PREREQUISITE WARNING: FORCE_LOGGING is not enabled"
CASE_2_UNCHANGED="primary-params"
CASE_3_TITLE="Shared password file"
CASE_3_PRIMARY_TOGGLE="pwfile-shared"
CASE_3_HOST="primary"
CASE_3_STEP="primary/01_gather_primary_info.sh"
CASE_3_EXIT="1"
CASE_3_MATCH="PREREQUISITE FAILED: REMOTE_LOGIN_PASSWORDFILE is not EXCLUSIVE"
CASE_3_UNCHANGED="primary-params"
