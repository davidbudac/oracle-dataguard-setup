# S04 - CDB (P04): Traditional, same layout, CDB role trigger, a new PDB
# service created with trigger/create_pdb_service.sh, wallets on both hosts,
# handoff with all flavors. Proofs: switchover roundtrip with the PDB services
# following the role, a new PDB arriving on the standby.
S_ID="s04"
S_TITLE="CDB: Traditional, CDB role trigger, new PDB service, wallet, switchover roundtrip, new PDB"
S_TIER="core"
S_KIND="build"
S_PRIMARY="p04"
WANT_STANDBY_DB_UNIQUE_NAME="dgcdb_s"
WANT_STORAGE_MODE="traditional"
WANT_PROTECTION="maxavail"
WANT_ROLE_TRIGGER="cdb"
WANT_NEW_SERVICES="pdb1:batch_svc"
WANT_WALLET="yes"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"
PROVE_REDO_ROUNDTRIP="yes"
PROVE_SWITCHOVER="roundtrip"
PROVE_NEW_PDB="yes"
EXPECT_STATUS_EXIT="1"
EXPECT_WARNINGS="Flashback is 'NO' on (primary|standby)|Fast-Start Failover is Disabled"
