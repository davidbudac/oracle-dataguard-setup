# S07 - OMF primary (P03) to an OMF standby whose online-log destinations are
# mapped to other directories (the TTY-gated db_create_online_log_dest_n prompt).
S_ID="s07"
S_TITLE="OMF to OMF with remapped online-log destinations"
S_TIER="full"
S_KIND="build"
S_PRIMARY="p03"
WANT_STANDBY_DB_UNIQUE_NAME="dgomf_s"
WANT_STORAGE_MODE="omf"
WANT_OMF_FILE_DEST="{FS1}/e2e/omf_stby"
WANT_STANDBY_FRA="{FS1}/e2e/fra_omf_stby:10"
WANT_ONLINE_LOG_DESTS="1={FS2}/e2e/stby_log_a 2={FS1}/e2e/stby_log_b"
WANT_PROTECTION="maxperf"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"
PROVE_REDO_ROUNDTRIP="yes"
EXPECT_STATUS_EXIT="1"
EXPECT_WARNINGS="Flashback is 'NO' on (primary|standby)|Fast-Start Failover is Disabled"
