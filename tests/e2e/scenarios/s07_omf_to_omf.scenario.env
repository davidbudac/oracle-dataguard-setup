# Scenario S07 - OMF primary with two online-log destinations; OMF standby with remapped destinations.

S_ID="s07"
S_TITLE="OMF to OMF with remapped online-log destinations"
S_TIER="full"
S_KIND="build"
S_PRIMARY="p03"
S_PRIMARY_OVERRIDES=""

WANT_STANDBY_DB_UNIQUE_NAME="dgomf_s"
WANT_STANDBY_SID=""

WANT_STORAGE_MODE="omf"
WANT_FS_MAP=""
WANT_PATH_OVERRIDES=""
WANT_SEPARATE_SRL_DIR=""
WANT_CONTROL_FILE_2_DIR=""
WANT_STANDBY_ORACLE_BASE=""
WANT_STANDBY_FRA="${ORACLE_BASE}/fra_omf:20"
WANT_OMF_FILE_DEST="${ORACLE_BASE}/oradata_omf"
WANT_ONLINE_LOG_DESTS="1=${ORACLE_BASE}/stby_log_a 2=${ORACLE_BASE}/stby_log_b"

WANT_CHECK_MODE_FIRST="no"

WANT_CLONE_CHANNELS=""
WANT_CLONE_RATE=""

WANT_PROTECTION="maxperf"
WANT_FSFO="no"
WANT_OBSERVER="none"
WANT_STANDBY_FLASHBACK="no"
WANT_ROLE_TRIGGER="none"
WANT_NEW_SERVICES=""
WANT_WALLET="no"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"

OPERATOR_NOTES="The standby's online-log destinations differ from the primary's: db_create_online_log_dest_1 and _2 go to the directories given in the brief."

INJECT_FAULTS=""
EXPECT_FAULT_OUTPUT=""

PROVE_REDO_ROUNDTRIP="yes"
PROVE_SWITCHOVER="none"
PROVE_FAILOVER="no"
PROVE_ADD_DATAFILE="no"
PROVE_NEW_PDB="no"
PROVE_STEP5_DECLINE="no"

EXPECT_STATUS_EXIT="0"
EXPECT_WARNINGS=""
EXPECT_TRANSCRIPT_MATCH=""

CASE_COUNT="0"
