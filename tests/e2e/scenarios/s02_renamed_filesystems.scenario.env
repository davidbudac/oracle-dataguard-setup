# S02 - the spread primary (P02) on a standby whose {FS2} and {FS3}
# filesystems are called {RENAME} (Q1b map), with a separate SRL directory, a
# second control-file directory, two RMAN channels and NO standby FRA (the
# primary has one: step 5 must RESET it). Cleanup --all at the end.
S_ID="s02"
S_TITLE="Renamed filesystems: Q1b map, separate SRL dir, second control-file dir, two channels, no standby FRA"
S_TIER="core"
S_KIND="build"
S_PRIMARY="p02"
WANT_STANDBY_DB_UNIQUE_NAME="dgspr_s"
WANT_STORAGE_MODE="traditional"
WANT_FS_MAP="{FS2:fs}={RENAME} {FS3:fs}={RENAME}"
WANT_SEPARATE_SRL_DIR="{FS1}/e2e/srl/dgspr_s"
WANT_CONTROL_FILE_2_DIR="{RENAME}/e2e_ctl/dgspr_s"
WANT_STANDBY_FRA="none"
WANT_CLONE_CHANNELS="2"
WANT_PROTECTION="maxperf"
WANT_HANDOFF="yes"
WANT_CLEANUP="all"
PROVE_REDO_ROUNDTRIP="yes"
PROVE_ADD_DATAFILE="yes"
EXPECT_STATUS_EXIT="1"
EXPECT_WARNINGS="Flashback is 'NO' on (primary|standby)|Fast-Start Failover is Disabled"
