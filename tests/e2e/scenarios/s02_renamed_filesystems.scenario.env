# Scenario S02 - spread primary; two filesystems are named differently on the standby host (Q1b).

S_ID="s02"
S_TITLE="Renamed filesystems: Q1b map, separate SRL directory, second control-file directory, two channels, no standby FRA"
S_TIER="core"
S_KIND="build"
S_PRIMARY="p02"
S_PRIMARY_OVERRIDES=""

WANT_STANDBY_DB_UNIQUE_NAME="dgspr_s"
WANT_STANDBY_SID=""

WANT_STORAGE_MODE="traditional"
WANT_FS_MAP="/u03=/u06 /u04=/u07"
WANT_PATH_OVERRIDES=""
WANT_SEPARATE_SRL_DIR="/u02/srl/dgspr_s"
WANT_CONTROL_FILE_2_DIR="/u06/control/dgspr_s"
WANT_STANDBY_ORACLE_BASE=""
WANT_STANDBY_FRA="none"
WANT_OMF_FILE_DEST=""
WANT_ONLINE_LOG_DESTS=""

WANT_CHECK_MODE_FIRST="no"

WANT_CLONE_CHANNELS="2"
WANT_CLONE_RATE=""

WANT_PROTECTION="maxperf"
WANT_FSFO="no"
WANT_OBSERVER="none"
WANT_STANDBY_FLASHBACK="no"
WANT_ROLE_TRIGGER="none"
WANT_NEW_SERVICES=""
WANT_WALLET="no"
WANT_HANDOFF="yes"
WANT_CLEANUP="all"

OPERATOR_NOTES="On the standby host /u03 is called /u06 and /u04 is called /u07; /u02 and /u05 keep their names. The standby must not use a fast recovery area."

INJECT_FAULTS=""
EXPECT_FAULT_OUTPUT=""

PROVE_REDO_ROUNDTRIP="yes"
PROVE_SWITCHOVER="none"
PROVE_FAILOVER="no"
PROVE_ADD_DATAFILE="yes"
PROVE_NEW_PDB="no"
PROVE_STEP5_DECLINE="no"

EXPECT_STATUS_EXIT="0"
EXPECT_WARNINGS=""
EXPECT_TRANSCRIPT_MATCH=""

CASE_COUNT="0"
