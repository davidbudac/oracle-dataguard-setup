# Scenario S05 - FSFO with the observer on the standby host; primary built with Flashback Database on.

S_ID="s05"
S_TITLE="FSFO, observer on the standby host, dedicated-user role trigger, failover proof"
S_TIER="core"
S_KIND="build"
S_PRIMARY="p01"
S_PRIMARY_OVERRIDES="P_FLASHBACK=yes"

WANT_STANDBY_DB_UNIQUE_NAME="dgtest_s"
WANT_STANDBY_SID=""

WANT_STORAGE_MODE="traditional"
WANT_FS_MAP=""
WANT_PATH_OVERRIDES=""
WANT_SEPARATE_SRL_DIR=""
WANT_CONTROL_FILE_2_DIR=""
WANT_STANDBY_ORACLE_BASE=""
WANT_STANDBY_FRA="none"
WANT_OMF_FILE_DEST=""
WANT_ONLINE_LOG_DESTS=""

WANT_CHECK_MODE_FIRST="no"

WANT_CLONE_CHANNELS=""
WANT_CLONE_RATE=""

WANT_PROTECTION="maxavail"
WANT_FSFO="yes"
WANT_OBSERVER="standby-host"
WANT_STANDBY_FLASHBACK="yes"
WANT_ROLE_TRIGGER="dedicated"
WANT_NEW_SERVICES=""
WANT_WALLET="no"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"

OPERATOR_NOTES="Maximum availability comes from step 9; do not run step 13. Flashback Database must be on on both members so a failed primary can be reinstated. No setup script turns it on on the standby, so do that yourself after step 7. The standby host has the same filesystems and Oracle paths as the primary."

INJECT_FAULTS=""
EXPECT_FAULT_OUTPUT=""

PROVE_REDO_ROUNDTRIP="yes"
PROVE_SWITCHOVER="none"
PROVE_FAILOVER="yes"
PROVE_ADD_DATAFILE="no"
PROVE_NEW_PDB="no"
PROVE_STEP5_DECLINE="no"

EXPECT_STATUS_EXIT="0"
EXPECT_WARNINGS=""
EXPECT_TRANSCRIPT_MATCH=""

CASE_COUNT="0"
