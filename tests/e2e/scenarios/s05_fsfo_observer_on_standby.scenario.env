# S05 - FSFO with the observer on the standby host (fsfo/observer.sh), the
# dedicated-user role trigger. Flashback on both members (the primary gets a
# FRA for it; no setup script turns flashback on on the standby, so the harness
# does what the walkthrough tells the operator to do). Proof: SHUTDOWN ABORT
# the primary -> automatic failover within the threshold -> reinstate -> switch back.
S_ID="s05"
S_TITLE="FSFO, observer on the standby host, dedicated-user role trigger, failover proof"
S_TIER="core"
S_KIND="build"
S_PRIMARY="p01"
S_PRIMARY_OVERRIDES="P_FLASHBACK=yes P_FRA_DIR={FS1}/e2e/fra_dgtest P_FRA_SIZE_GB=10"
WANT_STANDBY_DB_UNIQUE_NAME="dgtest_s"
WANT_STORAGE_MODE="traditional"
WANT_STANDBY_FRA="{FS1}/e2e/fra_dgtest_s:10"
WANT_PROTECTION="maxavail"
WANT_FSFO="yes"
WANT_OBSERVER="standby-host"
WANT_STANDBY_FLASHBACK="yes"
WANT_ROLE_TRIGGER="dedicated"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"
PROVE_REDO_ROUNDTRIP="yes"
PROVE_FAILOVER="yes"
EXPECT_STATUS_EXIT="0"
EXPECT_WARNINGS=""
