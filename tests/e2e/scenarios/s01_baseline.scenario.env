# S01 - the default path, on the SHARED network/admin and default listener
# (every other scenario isolates itself in a scratch TNS_ADMIN). Every step is
# dry-run with -n first. Max availability via step 13, SYS role trigger,
# handoff, default cleanup. Proofs: redo roundtrip, switchover roundtrip with
# the services following the role, declined step 5 re-run leaves the standby
# alone, an uncovered datafile directory becomes UNNAMED and the documented
# fix recovers.
S_ID="s01"
S_TITLE="Baseline: Traditional, same layout, -n first, max availability, SYS role trigger"
S_TIER="smoke"
S_KIND="build"
S_PRIMARY="p01"
S_NET="shared"
WANT_STANDBY_DB_UNIQUE_NAME="dgtest_s"
WANT_STORAGE_MODE="traditional"
WANT_CHECK_MODE_FIRST="yes"
WANT_PROTECTION="maxavail"
WANT_ROLE_TRIGGER="sys"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"
PROVE_REDO_ROUNDTRIP="yes"
PROVE_SWITCHOVER="roundtrip"
PROVE_STEP5_DECLINE="yes"
PROVE_UNCOVERED_DIR="yes"
EXPECT_STATUS_EXIT="1"
EXPECT_WARNINGS="Flashback is 'NO' on (primary|standby)|Fast-Start Failover is Disabled"
