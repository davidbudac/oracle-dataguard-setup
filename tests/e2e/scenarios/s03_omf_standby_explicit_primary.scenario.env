# S03 - OMF standby of the explicit-path primary (P02): mixed storage. The
# standby must not inherit the primary explicit control_files or FRA paths.
S_ID="s03"
S_TITLE="OMF standby of an explicit-path primary, max availability"
S_TIER="core"
S_KIND="build"
S_PRIMARY="p02"
WANT_STANDBY_DB_UNIQUE_NAME="dgspr_s"
WANT_STORAGE_MODE="omf"
WANT_OMF_FILE_DEST="{FS1}/e2e/omf_stby"
WANT_STANDBY_FRA="{FS2}/e2e/fra_stby:10"
WANT_PROTECTION="maxavail"
WANT_HANDOFF="yes"
WANT_CLEANUP="default"
PROVE_REDO_ROUNDTRIP="yes"
PROVE_ADD_DATAFILE="yes"
EXPECT_STATUS_EXIT="1"
EXPECT_WARNINGS="Flashback is 'NO' on (primary|standby)|Fast-Start Failover is Disabled"
