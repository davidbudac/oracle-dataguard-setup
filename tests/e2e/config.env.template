#!/usr/bin/env bash
# =============================================================================
# Oracle Data Guard E2E suite - lab configuration
# =============================================================================
# Copy this file to config.env and fill in the values for your lab. Then:
#
#   bash tests/e2e/e2e.sh doctor      # what the lab can do, what each scenario needs
#   bash tests/e2e/e2e.sh run --tier smoke
#
# What the lab must have (the doctor checks all of it and prints the fix):
#   - two hosts with Oracle 19c software (no databases needed; the suite creates
#     and drops its own), reachable by ssh as the oracle user from this machine
#     (directly, or through a jump host)
#   - an NFS share mounted read/write on both hosts (NFS_SHARE)
#   - python3 on both hosts (OL/RHEL 8+ have it) - the prompt driver needs it
#   - NO root: the suite only writes where the oracle user can write
#   - optional: a third host with an Oracle client or home (third-host observer
#     scenarios), reachable the same way
# =============================================================================

# --- Jump host (optional; empty = reach the DB hosts directly) ---
JUMP_HOST=""
JUMP_SSH_PORT="22"
JUMP_USER=""
JUMP_KEY=""                              # ssh key for the jump host (empty = default)

# --- Database hosts ---
PRIMARY_HOST=""                          # ssh target (IP or name) of the primary host
PRIMARY_SSH_PORT="22"
PRIMARY_ORACLE_HOSTNAME=""               # the name the host knows itself as (TNS/listener); empty = PRIMARY_HOST
STANDBY_HOST=""
STANDBY_SSH_PORT="22"
STANDBY_ORACLE_HOSTNAME=""
SSH_USER="oracle"                        # must own the Oracle software
SSH_KEY=""                               # ssh key for the DB hosts (empty = default)
SSH_OPTS="-o StrictHostKeyChecking=no -o ConnectTimeout=10 -o LogLevel=ERROR"

# --- Optional third host (FSFO observer away from both DB hosts) ---
HOST3=""                                 # empty = third-host scenarios are skipped
HOST3_SSH_PORT="22"
HOST3_ORACLE_HOSTNAME=""
HOST3_ORACLE_HOME=""                     # client or DB home with dgmgrl; empty = ORACLE_HOME

# --- Oracle software (same on both DB hosts) ---
ORACLE_HOME=""                           # e.g. /u01/app/oracle/product/19.0.0/dbhome_1
ORACLE_BASE=""                           # e.g. /u01/app/oracle

# --- Where the suite may write (no root needed) ---
# Three base directories the oracle user can write to, with DISTINCT first
# path components: the setup scripts treat the first component as "the
# filesystem" (Q1b), so these are the lab's filesystems as far as the tests
# are concerned. Slot 1 should be the ORACLE_BASE filesystem. Profiles refer
# to them as {FS1} {FS2} {FS3}; a scenario that needs a slot the lab lacks is
# skipped, with the fix printed by the doctor.
LAB_FS_SLOTS="/u01/app/oracle /home/oracle /var/tmp/oracle"
# A world-writable, disk-backed top-level directory on the STANDBY host that
# the "filesystem renamed on the standby" scenarios map a slot onto
# (/home/oracle/... becomes /tmp/oracle/...).
LAB_FS_RENAME_TARGET="/tmp"
# Per-host scratch root (prompt logs, scratch TNS_ADMIN, wallets, markers)
LAB_SCRATCH="/home/oracle/e2e"
# Port of the per-scenario scratch listener (scenarios never touch the shared listener)
LAB_SCRATCH_PORT="1531"

# --- NFS share the setup scripts exchange files through ---
NFS_SHARE="/OINSTALL/_dataguard_setup"

# --- Repository on the DB hosts ---
REPO_DIR="/home/oracle/dataguard_setup"  # the working tree is rsynced here (LOCAL_DEPLOY=true)
LOCAL_DEPLOY="true"                      # false = git clone/pull REPO_URL/REPO_BRANCH on the hosts instead
REPO_URL=""
REPO_BRANCH="main"

# --- Test passwords (runtime only) ---
TEST_SYS_PASSWORD="DgTest_2024#"
TEST_OBSERVER_USER="DG_OBSERVER"
TEST_OBSERVER_PASSWORD="ObsTest_2024#"
TEST_WALLET_PASSWORD="WalletTest_2024#"
TEST_TRIGGER_PASSWORD="DgAdmin_2024#"
TEST_DB_MEMORY_MB=1024                   # totalMemory for DBCA (a CDB profile raises it to >= 1536)
TEST_DB_CHARSET="AL32UTF8"
FSFO_THRESHOLD=30

# --- Behaviour ---
CLEANUP_ON_FAILURE="false"               # true = tear a failed scenario down anyway (default keeps it for a look)
STEP_TIMEOUT=3600                        # seconds a single workflow step may run
