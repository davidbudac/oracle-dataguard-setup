# =============================================================================
# Non-CDB -> PDB Migration Configuration
# =============================================================================
# Copy this file to config.env (or pass --config <file>) and fill in values.
#
# This config drives the 01..06 scripts. It assumes:
#   - The non-CDB and the target CDB are BOTH already up and running with their
#     own physical-standby Data Guard configurations.
#   - The same NFS share (NFS_SHARE) is mounted at the same path on both DB
#     hosts (primary side and standby side of the CDB).
# =============================================================================

# -- Source non-CDB database (will become a PDB) -----------------------------
SOURCE_DB_NAME="dgnonc"                 # DB_NAME of the non-CDB
SOURCE_DB_UNIQUE_NAME="dgnonc"          # DB_UNIQUE_NAME of the non-CDB primary
SOURCE_STANDBY_UNIQUE_NAME="dgnonc_s"   # DB_UNIQUE_NAME of the non-CDB standby
SOURCE_ORACLE_SID="dgnonc"              # ORACLE_SID for primary instance

# -- Target CDB --------------------------------------------------------------
TARGET_CDB_NAME="dgcdb"                 # DB_NAME of the destination CDB
TARGET_CDB_UNIQUE_NAME="dgcdb"          # DB_UNIQUE_NAME of the CDB primary
TARGET_CDB_STANDBY_UNIQUE_NAME="dgcdb_s"# DB_UNIQUE_NAME of the CDB standby
TARGET_CDB_ORACLE_SID="dgcdb"           # ORACLE_SID for CDB primary instance

# -- New PDB name ------------------------------------------------------------
# This is what the non-CDB will become after plugin + noncdb_to_pdb.sql
NEW_PDB_NAME="dgnonc_pdb"

# -- Oracle environment (must match on both hosts) ---------------------------
ORACLE_HOME="/u01/app/oracle/product/19.0.0/dbhome_1"
ORACLE_BASE="/u01/app/oracle"

# -- NFS share (mounted identically on both DB hosts) ------------------------
# Used both for the manifest XML and for staging non-CDB datafile copies that
# the CDB standby will read via STANDBY_PDB_SOURCE_FILE_DIRECTORY.
NFS_SHARE="/OINSTALL/_dataguard_setup"

# -- Where the new PDB's datafiles will live on the CDB primary --------------
# A subdirectory <NEW_PDB_NAME>/ is created under this dir. The CDB standby
# uses the same path on its local filesystem.
TARGET_PDB_DATAFILE_DIR="${ORACLE_BASE}/oradata/${TARGET_CDB_NAME}"

# -- Behaviour ---------------------------------------------------------------
# Set to "true" to skip the destructive cleanup of the non-CDB DG in step 06.
SKIP_DECOMMISSION="false"

# Used to confirm destructive actions (drop the source non-CDB).
# Set to "I_UNDERSTAND" to allow step 06 to drop the non-CDB after migration.
ALLOW_DROP_NONCDB="no"

# Where to drop logs from the migration scripts (also written to NFS_SHARE/logs)
MIGRATE_LOG_DIR="${NFS_SHARE}/logs/migrate_${SOURCE_DB_NAME}_to_${TARGET_CDB_NAME}"
