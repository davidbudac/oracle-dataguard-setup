# =============================================================================
# Non-CDB -> PDB Migration Configuration
# =============================================================================
# Copy this file to config.env (or point MIGRATE_CONFIG at another file) and fill in values.
#
# This config drives the 01..06 scripts. It assumes:
#   - The non-CDB and the target CDB are BOTH already up and running with their
#     own physical-standby Data Guard configurations.
#   - The same NFS share (NFS_SHARE) is mounted at the same path on both DB
#     hosts (primary side and standby side of the CDB).
# =============================================================================

# -- Source non-CDB database (will become a PDB) -----------------------------
SOURCE_DB_NAME="dgnonc"                 # DB_NAME of the non-CDB
SOURCE_DB_UNIQUE_NAME="dgnonc"          # DB_UNIQUE_NAME of the non-CDB primary
SOURCE_STANDBY_UNIQUE_NAME="dgnonc_s"   # DB_UNIQUE_NAME of the non-CDB standby
SOURCE_ORACLE_SID="dgnonc"              # ORACLE_SID for primary instance

# -- Target CDB --------------------------------------------------------------
TARGET_CDB_NAME="dgcdb"                 # DB_NAME of the destination CDB
TARGET_CDB_UNIQUE_NAME="dgcdb"          # DB_UNIQUE_NAME of the CDB primary
TARGET_CDB_STANDBY_UNIQUE_NAME="dgcdb_s"# DB_UNIQUE_NAME of the CDB standby
TARGET_CDB_ORACLE_SID="dgcdb"           # ORACLE_SID for CDB primary instance

# -- New PDB name ------------------------------------------------------------
# This is what the non-CDB will become after plugin + noncdb_to_pdb.sql
NEW_PDB_NAME="dgnonc_pdb"

# -- Oracle environment (must match on both hosts) ---------------------------
ORACLE_HOME="/u01/app/oracle/product/19.0.0/dbhome_1"
ORACLE_BASE="/u01/app/oracle"

# -- NFS share (must be MOUNTED, not just an existing directory) ------------
# Used both for the manifest XML and for staging non-CDB datafile copies that
# the CDB standby will read via STANDBY_PDB_SOURCE_FILE_DIRECTORY. The scripts
# refuse to run when the directory is missing or not writable.
NFS_SHARE="/OINSTALL/_dataguard_setup"

# -- Where the new PDB's datafiles will live on the CDB primary --------------
# A subdirectory <NEW_PDB_NAME>/ is created under this dir on the PRIMARY host.
# The STANDBY does not necessarily use this path: it derives its own location
# from its DB_FILE_NAME_CONVERT (or, with OMF, db_create_file_dest). Preflight
# (01) reads those on the CDB standby, checks they cover this directory,
# computes the standby-side directory and verifies it exists on the standby
# host (see STANDBY_SSH_TARGET / STANDBY_DIRS_CONFIRMED below).
TARGET_PDB_DATAFILE_DIR="${ORACLE_BASE}/oradata/${TARGET_CDB_NAME}"

# -- CDB standby access ------------------------------------------------------
# Needed to SET STANDBY_PDB_SOURCE_FILE_DIRECTORY on the standby (ALTER SYSTEM
# on the primary never reaches it) and to verify the PDB there in step 05.
# Connection: Oracle Wallet "/@<alias>" (common/setup_dg_wallet.sh); if that
# fails on a terminal you are asked for the standby SYS password (never stored).
# TNS alias of the CDB standby; defaults to TARGET_CDB_STANDBY_UNIQUE_NAME.
#TARGET_CDB_STANDBY_TNS_ALIAS="dgcdb_s"

# Path under which the CDB STANDBY HOST sees the staged datafiles. Defaults to
# the staging directory on this host (<NFS_SHARE>/migrate/<src>_to_<cdb>/datafiles),
# which is right when the share is mounted at the same path on both hosts. Set it
# only if the standby mounts the same export somewhere else.
#STANDBY_STAGE_DIR=""

# How step 01 verifies (and creates) the datafile directory on the standby host
# and that STANDBY_STAGE_DIR is visible there:
#   * STANDBY_SSH_TARGET="oracle@standbyhost" - passwordless ssh (BatchMode);
#     the directory is created and checked over ssh.
#   * otherwise the exact commands are printed and you must confirm them (TTY
#     prompt), or set STANDBY_DIRS_CONFIRMED="yes" for unattended runs after
#     creating them yourself.
#STANDBY_SSH_TARGET=""
#STANDBY_DIRS_CONFIRMED="no"

# -- Behaviour ---------------------------------------------------------------
# Set to "true" to skip the destructive cleanup of the non-CDB DG in step 06.
SKIP_DECOMMISSION="false"

# Used to confirm destructive actions (drop the source non-CDB).
# Set to "I_UNDERSTAND" to allow step 06 to drop the non-CDB after migration.
# An unattended run (MIGRATE_NONINTERACTIVE=1) additionally needs the
# environment variable MIGRATE_ALLOW_DROP=1, otherwise the drop is refused.
ALLOW_DROP_NONCDB="no"

# Where to drop logs from the migration scripts (also written to NFS_SHARE/logs)
MIGRATE_LOG_DIR="${NFS_SHARE}/logs/migrate_${SOURCE_DB_NAME}_to_${TARGET_CDB_NAME}"
